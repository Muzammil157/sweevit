{%- liquid
  assign card_variant = card_product.selected_or_first_available_variant
  assign badge_text = blank
  assign image_loading = 'lazy'
  if lazy_load == false
    assign image_loading = 'eager'
  endif

  for tag in card_product.tags
    assign tag_downcase = tag | downcase
    if tag_downcase == 'best-seller' or tag_downcase == 'bestseller'
      assign badge_text = 'BEST SELLER'
      break
    elsif tag_downcase == 'bundle'
      assign badge_text = 'BUNDLE'
      break
    endif
  endfor

  if badge_text == blank and card_product.compare_at_price > card_product.price and card_product.available
    assign price_diff = card_product.compare_at_price | minus: card_product.price
    assign save_percent = price_diff | times: 100.0 | divided_by: card_product.compare_at_price | round
    assign badge_text = 'SAVE ' | append: save_percent | append: '%'
  endif

  assign rating_value = card_product.metafields.reviews.rating.value.rating
  assign rating_count = card_product.metafields.reviews.rating_count
  assign rating_floor = rating_value | floor
  if rating_value == blank
    assign rating_floor = 5
  endif
-%}

<article class="sweevit-shop-card">
  <div class="sweevit-shop-card__media">
    {%- if badge_text != blank -%}
      <span class="sweevit-shop-card__badge">{{ badge_text }}</span>
    {%- endif -%}

    <button type="button" class="sweevit-shop-card__wishlist" aria-label="Add to wishlist">
      <svg width="18" height="16" viewBox="0 0 18 16" fill="none" aria-hidden="true">
        <path d="M9 15.25L7.775 14.1375C3.9 10.65 1 8.0875 1 4.875C1 2.3875 2.9875 0.375 5.5 0.375C6.8625 0.375 8.1625 0.9625 9 1.9125C9.8375 0.9625 11.1375 0.375 12.5 0.375C15.0125 0.375 17 2.3875 17 4.875C17 8.0875 14.1 10.65 10.225 14.1375L9 15.25Z" stroke="currentColor" stroke-width="1.2"/>
      </svg>
    </button>

    <a href="{{ card_product.url }}" class="sweevit-shop-card__image-link" tabindex="-1" aria-hidden="true">
      <div class="sweevit-shop-card__image-frame">
        {%- if card_product.featured_media -%}
          {{
            card_product.featured_media
            | image_url: width: 400
            | image_tag:
              class: 'sweevit-shop-card__image',
              loading: image_loading,
              widths: '100, 200, 300, 400',
              sizes: '100px',
              alt: card_product.featured_media.alt | default: card_product.title
          }}
        {%- else -%}
          <img
            src="{{ 'MiniPouch-product.png' | asset_url }}"
            class="sweevit-shop-card__image"
            loading="lazy"
            width="100"
            height="140"
            alt="{{ card_product.title | escape }}"
          >
        {%- endif -%}
      </div>
    </a>
  </div>

  <div class="sweevit-shop-card__body">
    <h3 class="sweevit-shop-card__title">
      <a href="{{ card_product.url }}">{{ card_product.title | escape }}</a>
    </h3>

    <!-- Start of Judge.me code -->
    <div style='{{ jm_style }}' class='jdgm-widget jdgm-preview-badge' data-id='{{ card_product.id }}' data-auto-install='false'>
      {{ card_product.metafields.judgeme.badge }}
    </div>
    <!-- End of Judge.me code -->

    <div class="sweevit-shop-card__rating" aria-label="{% if rating_value != blank %}{{ rating_value }} out of 5 stars{% else %}5 out of 5 stars{% endif %}">
      <span class="sweevit-shop-card__stars" aria-hidden="true">
        {%- for i in (1..5) -%}
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M6 1L7.545 4.13L11 4.635L8.5 7.07L9.09 10.5L6 8.885L2.91 10.5L3.5 7.07L1 4.635L4.455 4.13L6 1Z" fill="{% if i <= rating_floor %}#D9A93A{% else %}#E6E6E6{% endif %}"/>
          </svg>
        {%- endfor -%}
      </span>
      {%- if rating_count != blank -%}
        <span class="sweevit-shop-card__review-count">({{ rating_count }})</span>
      {%- endif -%}
    </div>

    <p class="sweevit-shop-card__price">
      {{ card_variant.price | money }}
    </p>

    {%- if card_product.available -%}
      <product-form class="sweevit-shop-card__form" data-section-id="{{ section_id }}">
        {%- form 'product', card_product, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" value="{{ card_variant.id }}">
          <button type="submit" name="add" class="sweevit-shop-card__atc">
            <span>{{ button_label | default: 'Add to cart' | escape }}</span>
            {%- render 'sweevit-loading-spinner' -%}
          </button>
        {%- endform -%}
      </product-form>
    {%- else -%}
      <button type="button" class="sweevit-shop-card__atc" disabled>
        <span>{{ 'products.product.sold_out' | t }}</span>
      </button>
    {%- endif -%}
  </div>
</article>
