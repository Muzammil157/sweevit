{{ 'sweevit-design-system.css' | asset_url | stylesheet_tag }}
{{ 'section-sweevit-about-us.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #SweevitAboutUs-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #SweevitAboutUs-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="SweevitAboutUs-{{ section.id }}"
  class="sweevit-about-us"
>
  <div class="sweevit-about-us__inner">
    <div class="sweevit-about-us__grid">
      <div class="sweevit-about-us__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sweevit-about-us__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="sweevit-about-us__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="sweevit-about-us__text">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>

      <div class="sweevit-about-us__media">
        <div class="sweevit-about-us__media-glow" aria-hidden="true"></div>

        <div class="sweevit-about-us__media-frame">
          {%- if section.settings.image != blank -%}
            {%- assign about_image_alt = section.settings.image.alt | default: section.settings.heading | escape -%}
            {{
              section.settings.image
              | image_url: width: 1040
              | image_tag:
                class: 'sweevit-about-us__image',
                widths: '400, 520, 780, 1040',
                sizes: '(min-width: 990px) 520px, 100vw',
                alt: about_image_alt,
                width: 520,
                height: 480,
                loading: 'lazy'
            }}
          {%- else -%}
            <img
              src="{{ 'about-us-placeholder.svg' | asset_url }}"
              alt=""
              class="sweevit-about-us__image sweevit-about-us__image--placeholder"
              width="520"
              height="480"
              loading="lazy"
              aria-hidden="true"
            >
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Us",
  "tag": "section",
  "class": "section-sweevit-about-us",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Subheading",
      "default": "OUR STORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We Believe Wellness Should Feel Effortless."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Paragraph",
      "default": "Sweevit was born from a simple idea: daily wellness shouldn't require a cabinet full of capsules. Just one ritual, every day focus, energy, and wellness, made enjoyable."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Recommended size: 520 x 480px. Shows a gradient placeholder when empty."
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "About Us"
    }
  ]
}
{% endschema %}
