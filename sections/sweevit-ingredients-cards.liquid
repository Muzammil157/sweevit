{{ 'sweevit-design-system.css' | asset_url | stylesheet_tag }}
{{ 'section-sweevit-ingredients-cards.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #SweevitIngredientsCards-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #SweevitIngredientsCards-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="SweevitIngredientsCards-{{ section.id }}"
  class="sweevit-ingredients-cards"
>
  <div class="sweevit-ingredients-cards__inner">
    {%- if section.blocks.size > 0 -%}
      <div class="sweevit-ingredients-cards__list">
        {%- for block in section.blocks -%}
          <article class="sweevit-ingredients-cards__card" {{ block.shopify_attributes }}>
            <div class="sweevit-ingredients-cards__icon-wrap" aria-hidden="true">
              <div class="sweevit-ingredients-cards__icon-bg">
                {%- if block.settings.icon_image != blank -%}
                  {%- assign icon_alt = block.settings.title | default: 'Ingredient icon' | escape -%}
                  {{
                    block.settings.icon_image
                    | image_url: width: 96
                    | image_tag: alt: icon_alt, loading: 'lazy', class: 'sweevit-ingredients-cards__icon-image'
                  }}
                {%- else -%}
                  {%- case block.settings.icon_asset -%}
                    {%- when 'raw_honey' -%}
                      <img
                        src="{{ 'raw-honey.png' | asset_url }}"
                        alt=""
                        class="sweevit-ingredients-cards__icon-image"
                        width="24"
                        height="24"
                        loading="lazy"
                      >
                    {%- when 'vitamin_b' -%}
                      <img
                        src="{{ 'vitman-b-complex.png' | asset_url }}"
                        alt=""
                        class="sweevit-ingredients-cards__icon-image"
                        width="24"
                        height="24"
                        loading="lazy"
                      >
                    {%- when 'l_theanine' -%}
                      <img
                        src="{{ 'l-theanine.png' | asset_url }}"
                        alt=""
                        class="sweevit-ingredients-cards__icon-image"
                        width="24"
                        height="24"
                        loading="lazy"
                      >
                    {%- when 'zinc' -%}
                      <img
                        src="{{ 'zinc.png' | asset_url }}"
                        alt=""
                        class="sweevit-ingredients-cards__icon-image"
                        width="24"
                        height="24"
                        loading="lazy"
                      >
                    {%- when 'lions_mane' -%}
                      {{- 'wellness.svg' | inline_asset_content -}}
                    {%- else -%}
                      {{- 'focus.svg' | inline_asset_content -}}
                  {%- endcase -%}
                {%- endif -%}
              </div>
            </div>

            <div class="sweevit-ingredients-cards__content">
              {%- if block.settings.title != blank -%}
                <h2 class="sweevit-ingredients-cards__title">{{ block.settings.title | escape }}</h2>
              {%- endif -%}

              {%- if block.settings.badge != blank -%}
                <span class="sweevit-ingredients-cards__badge">{{ block.settings.badge | escape }}</span>
              {%- endif -%}

              {%- if block.settings.source != blank -%}
                <p class="sweevit-ingredients-cards__source">
                  <span class="sweevit-ingredients-cards__source-label">SOURCE:</span>
                  {{ block.settings.source | escape }}
                </p>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="sweevit-ingredients-cards__description">{{ block.settings.description | escape }}</p>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ingredients Cards",
  "tag": "section",
  "class": "section-sweevit-ingredients-cards",
  "settings": [
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient card",
      "settings": [
        {
          "type": "select",
          "id": "icon_asset",
          "label": "Icon",
          "options": [
            {
              "value": "raw_honey",
              "label": "Raw Honey"
            },
            {
              "value": "ashwagandha",
              "label": "Ashwagandha"
            },
            {
              "value": "vitamin_b",
              "label": "Vitamin B Complex"
            },
            {
              "value": "lions_mane",
              "label": "Lion's Mane"
            },
            {
              "value": "l_theanine",
              "label": "L-Theanine"
            },
            {
              "value": "zinc",
              "label": "Zinc & Magnesium"
            }
          ],
          "default": "raw_honey"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon",
          "info": "Optional. Overrides the selected icon."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Raw Honey"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "500mg"
        },
        {
          "type": "text",
          "id": "source",
          "label": "Source",
          "default": "Sourced from small-batch apiaries in the Punjab region."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Natural energy source and prebiotic support for gut health and sustained vitality."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients Cards"
    }
  ]
}
{% endschema %}
