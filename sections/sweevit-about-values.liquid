{{ 'sweevit-design-system.css' | asset_url | stylesheet_tag }}
{{ 'section-sweevit-about-values.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #SweevitAboutValues-{{ section.id }} {
    --sweevit-about-values-bg: {{ section.settings.background_color }};
    padding-top: 40px;
    padding-bottom: 40px;
  }

  @media screen and (min-width: 750px) {
    #SweevitAboutValues-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="SweevitAboutValues-{{ section.id }}"
  class="sweevit-about-values"
>
  <div class="sweevit-about-values__inner">
    <div class="sweevit-about-values__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sweevit-about-values__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="sweevit-about-values__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="sweevit-about-values__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="sweevit-about-values__grid">
        {%- for block in section.blocks -%}
          <article class="sweevit-about-values__card" {{ block.shopify_attributes }}>
            <div class="sweevit-about-values__icon-wrap">
              {%- case block.settings.icon -%}
                {%- when 'transparency' -%}
                  {{- 'ix_electrical-energy-filled.svg' | inline_asset_content -}}
                {%- when 'durability' -%}
                  {{- 'bxs_diamond.svg' | inline_asset_content -}}
                {%- else -%}
                  {{- 'focus.svg' | inline_asset_content -}}
              {%- endcase -%}
            </div>

            {%- if block.settings.title != blank -%}
              <h3 class="sweevit-about-values__card-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <p class="sweevit-about-values__card-text">{{ block.settings.description | escape }}</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About Values",
  "tag": "section",
  "class": "section-sweevit-about-values",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHAT WE STAND FOR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Values"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Three core values behind each delicious gummy."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "simplicity",
              "label": "Simplicity (concentric circles)"
            },
            {
              "value": "transparency",
              "label": "Transparency (lightning)"
            },
            {
              "value": "durability",
              "label": "Designed to last (diamond)"
            }
          ],
          "default": "simplicity"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Simplicity First"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Mental clarity & concentration to power through your day without distraction."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "icon": "simplicity",
            "title": "Simplicity First",
            "description": "Mental clarity & concentration to power through your day without distraction."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "transparency",
            "title": "Radical Transparency",
            "description": "Natural energy without the crash — sustained vitality from morning to evening."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "durability",
            "title": "Designed to Last",
            "description": "Support your body & mind daily with functional ingredients you can trust."
          }
        }
      ]
    }
  ]
}
{% endschema %}
