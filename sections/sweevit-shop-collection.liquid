{{ 'sweevit-design-system.css' | asset_url | stylesheet_tag }}
{{ 'section-sweevit-shop-collection.css' | asset_url | stylesheet_tag }}
{{ 'sweevit-loading-spinner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign shop_collection = section.settings.shop_collection | default: collection
  assign page_heading = section.settings.heading
  if page_heading == blank
    assign page_heading = collection.title
  endif

  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign products_count = collection.products_count
-%}

<section id="SweevitShop-{{ section.id }}" class="sweevit-shop">
  <div class="sweevit-shop__breadcrumb">
    <div class="sweevit-shop__inner">
      <nav class="sweevit-shop__breadcrumb-nav" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home | escape }}</a>
        <span class="sweevit-shop__breadcrumb-sep" aria-hidden="true">/</span>
        <span class="sweevit-shop__breadcrumb-current" aria-current="page">{{ section.settings.breadcrumb_shop | escape }}</span>
      </nav>
    </div>
  </div>

  <div class="sweevit-shop__banner">
    <div class="sweevit-shop__inner sweevit-shop__banner-inner">
      <h1 class="sweevit-shop__heading">{{ page_heading | escape }}</h1>
      {%- if section.settings.banner_description != blank or products_count > 0 -%}
        <p class="sweevit-shop__description">
          {%- if products_count > 0 -%}
            {{ products_count }} {{ section.settings.products_label | escape }}
          {%- endif -%}
          {%- if section.settings.banner_description != blank -%}
            {%- if products_count > 0 -%} | {% endif -%}
            {{ section.settings.banner_description | escape }}
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>
  </div>

  <div class="sweevit-shop__toolbar">
    <div class="sweevit-shop__inner sweevit-shop__toolbar-inner">
      {%- if section.blocks.size > 0 -%}
        <div class="sweevit-shop__tabs" role="tablist" aria-label="Product categories">
          {%- for block in section.blocks -%}
            {%- liquid
              assign tab_collection = block.settings.collection
              assign tab_url = collection.url
              assign is_active = false

              if tab_collection != blank
                assign tab_url = tab_collection.url
                if tab_collection.id == collection.id
                  assign is_active = true
                endif
              elsif block.settings.is_all_tab
                if shop_collection != blank
                  assign tab_url = shop_collection.url
                  if shop_collection.id == collection.id
                    assign is_active = true
                  endif
                elsif collection.handle == 'all'
                  assign is_active = true
                endif
              endif
            -%}
            <a
              href="{{ tab_url }}"
              class="sweevit-shop__tab{% if is_active %} is-active{% endif %}"
              role="tab"
              aria-selected="{% if is_active %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label | escape }}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.enable_sorting -%}
        <form class="sweevit-shop__sort" id="SweevitShopSort-{{ section.id }}">
          <span class="sweevit-shop__sort-label">{{ section.settings.sort_label | escape }}</span>
          <div class="sweevit-shop__sort-select-wrap">
            <select
              name="sort_by"
              class="sweevit-shop__sort-select"
              id="SweevitShopSortSelect-{{ section.id }}"
              aria-label="{{ section.settings.sort_label | escape }}"
            >
              {%- for option in collection.sort_options -%}
                <option
                  value="{{ option.value | escape }}"
                  {% if option.value == sort_by %}
                    selected="selected"
                  {% endif %}
                >
                  {{ option.name | escape }}
                </option>
              {%- endfor -%}
            </select>
            <span class="sweevit-shop__sort-icon" aria-hidden="true">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </form>
      {%- endif -%}
    </div>
  </div>

  <collection-component
    view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
    data-collection-id="{{ collection.id }}"
  >
    <div class="sweevit-shop__inner sweevit-shop__grid-wrap">
      {%- paginate collection.products by section.settings.products_per_page -%}
        <div class="sweevit-shop__grid" id="SweevitShopGrid-{{ section.id }}">
          {%- if collection.products.size == 0 -%}
            <p class="sweevit-shop__empty">{{ section.settings.empty_text | escape }}</p>
          {%- else -%}
            {%- for product in collection.products -%}
              {%-
                render 'sweevit-shop-product-card',
                card_product: product,
                section_id: section.id,
                button_label: section.settings.button_label,
                lazy_load: true
              -%}
            {%- endfor -%}
          {%- endif -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="sweevit-shop__pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}">{{ section.settings.pagination_previous | escape }}</a>
            {%- endif -%}

            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                {%- if part.title == paginate.current_page -%}
                  <span class="is-current" aria-current="page">{{ part.title }}</span>
                {%- else -%}
                  <span>{{ part.title }}</span>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}">{{ section.settings.pagination_next | escape }}</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </collection-component>
</section>

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'sweevit-shop-collection.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Sweevit Shop",
  "tag": "section",
  "class": "section-sweevit-shop-collection",
  "settings": [
    {
      "type": "header",
      "content": "Breadcrumb"
    },
    {
      "type": "text",
      "id": "breadcrumb_home",
      "label": "Home label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "breadcrumb_shop",
      "label": "Shop label",
      "default": "Shop"
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop All",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "text",
      "id": "products_label",
      "label": "Products count label",
      "default": "products"
    },
    {
      "type": "text",
      "id": "banner_description",
      "label": "Banner description",
      "default": "Functional gummies for every part of your daily ritual"
    },
    {
      "type": "collection",
      "id": "shop_collection",
      "label": "Main shop collection",
      "info": "Used for the All tab. Defaults to the current collection."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "label": "Products per page",
      "default": 12
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty collection text",
      "default": "No products found in this collection."
    },
    {
      "type": "header",
      "content": "Sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "text",
      "id": "sort_label",
      "label": "Sort label",
      "default": "Sort by:"
    },
    {
      "type": "header",
      "content": "Pagination"
    },
    {
      "type": "text",
      "id": "pagination_previous",
      "label": "Previous label",
      "default": "Prev"
    },
    {
      "type": "text",
      "id": "pagination_next",
      "label": "Next label",
      "default": "Next"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Collection tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "All"
        },
        {
          "type": "checkbox",
          "id": "is_all_tab",
          "label": "All products tab",
          "default": false,
          "info": "Enable for the main shop tab. Links to the main shop collection."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Select a collection for this tab. Leave empty when using All products tab."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sweevit Shop",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "label": "All",
            "is_all_tab": true
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "Focus"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "Energy"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "Wellness"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "Sleep"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "Bundles"
          }
        }
      ]
    }
  ]
}
{% endschema %}
