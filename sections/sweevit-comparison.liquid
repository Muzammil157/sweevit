{{ 'sweevit-design-system.css' | asset_url | stylesheet_tag }}
{{ 'section-sweevit-comparison.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #SweevitComparison-{{ section.id }} {
    --sweevit-comparison-bg: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #SweevitComparison-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="SweevitComparison-{{ section.id }}"
  class="sweevit-comparison"
>
  <div class="sweevit-comparison__inner">
    <div class="sweevit-comparison__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sweevit-comparison__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="sweevit-comparison__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="sweevit-comparison__table-wrap" role="region" aria-label="{{ section.settings.heading | escape }}">
      <table class="sweevit-comparison__table">
        <thead>
          <tr>
            <th scope="col" class="sweevit-comparison__th sweevit-comparison__th--feature">
              <span class="visually-hidden">Feature</span>
            </th>
            <th scope="col" class="sweevit-comparison__th sweevit-comparison__th--brand sweevit-comparison__th--highlight">
              {{ section.settings.brand_column_label | escape }}
            </th>
            <th scope="col" class="sweevit-comparison__th sweevit-comparison__th--brand">
              {{ section.settings.competitor_1_label | escape }}
            </th>
            <th scope="col" class="sweevit-comparison__th sweevit-comparison__th--brand">
              {{ section.settings.competitor_2_label | escape }}
            </th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr class="sweevit-comparison__row" {{ block.shopify_attributes }}>
              <th scope="row" class="sweevit-comparison__feature">
                {{ block.settings.feature | escape }}
              </th>
              <td class="sweevit-comparison__cell">
                {%- if block.settings.sweevit_has -%}
                  <span class="sweevit-comparison__icon sweevit-comparison__icon--yes" aria-label="Yes">
                    {{- 'icon-checkmark.svg' | inline_asset_content -}}
                  </span>
                {%- else -%}
                  <span class="sweevit-comparison__icon sweevit-comparison__icon--no" aria-label="No">—</span>
                {%- endif -%}
              </td>
              <td class="sweevit-comparison__cell">
                {%- if block.settings.competitor_1_has -%}
                  <span class="sweevit-comparison__icon sweevit-comparison__icon--competitor-yes" aria-label="Yes">
                    {{- 'icon-checkmark.svg' | inline_asset_content -}}
                  </span>
                {%- else -%}
                  <span class="sweevit-comparison__icon sweevit-comparison__icon--no" aria-label="No">—</span>
                {%- endif -%}
              </td>
              <td class="sweevit-comparison__cell">
                {%- if block.settings.competitor_2_has -%}
                  <span class="sweevit-comparison__icon sweevit-comparison__icon--competitor-yes" aria-label="Yes">
                    {{- 'icon-checkmark.svg' | inline_asset_content -}}
                  </span>
                {%- else -%}
                  <span class="sweevit-comparison__icon sweevit-comparison__icon--no" aria-label="No">—</span>
                {%- endif -%}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sweevit Comparison",
  "tag": "section",
  "class": "section-sweevit-comparison",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Difference"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Sweevit Wins"
    },
    {
      "type": "text",
      "id": "brand_column_label",
      "label": "Brand column label",
      "default": "Sweevit"
    },
    {
      "type": "text",
      "id": "competitor_1_label",
      "label": "Competitor 1 label",
      "default": "Capsules"
    },
    {
      "type": "text",
      "id": "competitor_2_label",
      "label": "Competitor 2 label",
      "default": "Other Gummies"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature",
          "default": "Clinically Studied"
        },
        {
          "type": "checkbox",
          "id": "sweevit_has",
          "label": "Sweevit has feature",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "competitor_1_has",
          "label": "Competitor 1 has feature",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "competitor_2_has",
          "label": "Competitor 2 has feature",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sweevit Comparison",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "feature": "Natural energy, no crash",
            "sweevit_has": true,
            "competitor_1_has": false,
            "competitor_2_has": false
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Enjoyable daily experience",
            "sweevit_has": true,
            "competitor_1_has": false,
            "competitor_2_has": true
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Premium clean ingredients",
            "sweevit_has": true,
            "competitor_1_has": true,
            "competitor_2_has": false
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Subscription & rewards",
            "sweevit_has": true,
            "competitor_1_has": false,
            "competitor_2_has": false
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Holographic premium packaging",
            "sweevit_has": true,
            "competitor_1_has": false,
            "competitor_2_has": false
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Third-party lab tested",
            "sweevit_has": true,
            "competitor_1_has": true,
            "competitor_2_has": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
