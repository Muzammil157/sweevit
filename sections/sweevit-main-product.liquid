{{ 'sweevit-design-system.css' | asset_url | stylesheet_tag }}
{{ 'section-sweevit-product-showcase.css' | asset_url | stylesheet_tag }}
{{ 'section-sweevit-main-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign onetime_price = current_variant.price | money
  assign first_selling_plan = nil
  assign subscribe_price = blank

  for allocation in current_variant.selling_plan_allocations
    assign first_selling_plan = allocation.selling_plan
    assign subscribe_price = allocation.price | money
    break
  endfor

  if subscribe_price == blank
    if section.settings.subscribe_price_fallback != blank
      assign subscribe_price = section.settings.subscribe_price_fallback
    else
      assign subscribe_cents = current_variant.price | times: 0.8 | round
      assign subscribe_price = subscribe_cents | money
    endif
  endif

  assign eyebrow = section.settings.eyebrow
  assign tagline = section.settings.tagline
  if tagline == blank and product.description != blank
    assign tagline = product.description | strip_html | truncate: 120
  endif

  assign sale_price = current_variant.price
  assign regular_price = current_variant.compare_at_price
  assign savings_percent = 0
  if regular_price != blank and regular_price > sale_price
    assign savings_percent = regular_price | minus: sale_price | times: 100.0 | divided_by: regular_price | round
  endif

  assign product_form_id = 'sweevit-pdp-form-' | append: section.id
  assign default_option = section.settings.default_purchase_option
  assign show_subscribe = section.settings.show_subscribe
  assign shop_url = routes.all_products_collection_url | default: '/collections/all'
-%}

{%- style -%}
  #SweevitPdp-{{ section.id }} {
    --sweevit-product-bg: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #SweevitPdp-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section id="SweevitPdp-{{ section.id }}" class="sweevit-product sweevit-pdp">
  <sweevit-product-showcase class="sweevit-product__inner sweevit-pdp__inner">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="sweevit-pdp__breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home | escape }}</a>
        <span class="sweevit-pdp__breadcrumb-sep" aria-hidden="true">/</span>
        <a href="{{ shop_url }}">{{ section.settings.breadcrumb_shop | escape }}</a>
        <span class="sweevit-pdp__breadcrumb-sep" aria-hidden="true">/</span>
        <span class="sweevit-pdp__breadcrumb-current" aria-current="page">{{ product.title | escape }}</span>
      </nav>
    {%- endif -%}

    <div class="sweevit-product__grid sweevit-pdp__grid">
      <div class="sweevit-product__media sweevit-pdp__media">
        <div class="sweevit-product__media-frame sweevit-pdp__media-frame">
          {%- if product.media.size > 0 -%}
            {%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
            {{
              featured_media
              | image_url: width: 1200
              | image_tag:
                class: 'sweevit-product__image sweevit-pdp__main-image',
                loading: 'eager',
                fetchpriority: 'high',
                widths: '400, 600, 800, 1000, 1200',
                sizes: '(min-width: 990px) 564px, 100vw',
                alt: product.title,
                data-pdp-main-image: ''
            }}
          {%- else -%}
            <img
              src="{{ 'MiniPouch-product.png' | asset_url }}"
              class="sweevit-product__image sweevit-pdp__main-image"
              loading="eager"
              width="564"
              height="734"
              alt="{{ product.title | escape }}"
              data-pdp-main-image
            >
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <ul class="sweevit-pdp__thumbnails" role="list">
            {%- for media in product.media limit: 5 -%}
              {%- if media.media_type == 'image' -%}
                <li>
                  <button
                    type="button"
                    class="sweevit-pdp__thumbnail{% if forloop.first %} is-active{% endif %}"
                    data-pdp-thumbnail
                    data-src="{{ media | image_url: width: 1200 }}"
                    data-srcset="{{ media | image_url: width: 400 }} 400w, {{ media | image_url: width: 800 }} 800w, {{ media | image_url: width: 1200 }} 1200w"
                    aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"
                    aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                  >
                    {{
                      media
                      | image_url: width: 160
                      | image_tag:
                        loading: 'lazy',
                        widths: '80, 160',
                        sizes: '80px',
                        alt: media.alt | default: product.title
                    }}
                  </button>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="sweevit-product__content sweevit-pdp__content">
        {%- if eyebrow != blank -%}
          <p class="sweevit-pdp__eyebrow">{{ eyebrow | escape }}</p>
        {%- endif -%}

        <h1 class="sweevit-product__title">{{ product.title | escape }}</h1>

        {%- if tagline != blank -%}
          <p class="sweevit-pdp__tagline">{{ tagline | escape }}</p>
        {%- endif -%}

        {%- if section.settings.show_rating -%}
          <div class="sweevit-pdp__rating-row">
            <span class="sweevit-product__stars sweevit-pdp__stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                {{- 'icon-star-filled.svg' | inline_asset_content -}}
              {%- endfor -%}
            </span>
            <span class="sweevit-pdp__rating-text">
              {{ section.settings.rating_value | escape }} · {{ section.settings.review_count | escape }} {{ section.settings.review_label | escape -}}
              {%- if section.settings.repurchase_text != blank %} · <strong class="sweevit-pdp__repurchase">{{ section.settings.repurchase_text | escape }}</strong>{% endif -%}
            </span>
          </div>
        {%- endif -%}

        <div class="sweevit-pdp__price-row">
          <span class="sweevit-pdp__sale-price">{{ sale_price | money }}</span>
          {%- if regular_price != blank and regular_price > sale_price -%}
            <span class="sweevit-pdp__regular-price">
              <s>{{ regular_price | money }}</s>
            </span>
            {%- if savings_percent > 0 -%}
              <span class="sweevit-pdp__save-badge">{{ section.settings.save_badge_label | replace: '[percent]', savings_percent }}</span>
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="sweevit-product__highlights sweevit-pdp__highlights">
            {%- for block in section.blocks -%}
              {%- if block.type == 'highlight' -%}
                <article class="sweevit-product__highlight" {{ block.shopify_attributes }}>
                  <div class="sweevit-product__highlight-icon" aria-hidden="true">
                    {%- case block.settings.icon -%}
                      {%- when 'energy' -%}
                        {{- 'ix_electrical-energy-filled.svg' | inline_asset_content -}}
                      {%- when 'wellness' -%}
                        {{- 'wellness.svg' | inline_asset_content -}}
                      {%- else -%}
                        {{- 'focus.svg' | inline_asset_content -}}
                    {%- endcase -%}
                  </div>
                  <div class="sweevit-product__highlight-body">
                    {%- if block.settings.title != blank -%}
                      <h2 class="sweevit-product__highlight-title">{{ block.settings.title | escape }}</h2>
                    {%- endif -%}
                    {%- if block.settings.description != blank -%}
                      <p class="sweevit-product__highlight-text">{{ block.settings.description | escape }}</p>
                    {%- endif -%}
                  </div>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="sweevit-pdp__purchase-section">
          <p class="sweevit-pdp__purchase-label">{{ section.settings.purchase_options_label | escape }}</p>

          <div class="sweevit-product__options sweevit-pdp__options" role="radiogroup" aria-label="Purchase option">
            <label
              class="sweevit-product__option sweevit-pdp__option{% if default_option == 'onetime' %} is-active{% endif %}"
              data-purchase-option
              tabindex="0"
            >
              <input
                type="radio"
                name="purchase-option-{{ section.id }}"
                value="onetime"
                {% if default_option == 'onetime' %}checked{% endif %}
              >
              <span class="sweevit-product__option-row">
                <span class="sweevit-product__option-left">
                  <span class="sweevit-product__option-radio" aria-hidden="true"></span>
                  <span class="sweevit-product__option-label">{{ section.settings.one_time_label | escape }}</span>
                </span>
                <span class="sweevit-product__option-price" data-onetime-price>{{ onetime_price }}</span>
              </span>
            </label>

            {%- if show_subscribe -%}
              <label
                class="sweevit-product__option sweevit-pdp__option{% if default_option == 'subscribe' %} is-active{% endif %}"
                data-purchase-option
                {% if first_selling_plan != nil %}
                  data-selling-plan-id="{{ first_selling_plan.id }}"
                {% endif %}
                tabindex="0"
              >
                <input
                  type="radio"
                  name="purchase-option-{{ section.id }}"
                  value="subscribe"
                  {% if default_option == 'subscribe' %}checked{% endif %}
                >
                <span class="sweevit-product__option-row">
                  <span class="sweevit-product__option-left">
                    <span class="sweevit-product__option-radio" aria-hidden="true"></span>
                    <span class="sweevit-product__option-label">{{ section.settings.subscribe_label | escape }}</span>
                  </span>
                  <span class="sweevit-product__option-price" data-subscribe-price>{{ subscribe_price }}</span>
                </span>

                {%- if section.settings.perk_1 != blank or section.settings.perk_2 != blank or section.settings.perk_3 != blank -%}
                  <ul class="sweevit-product__option-perks">
                    {%- if section.settings.perk_1 != blank -%}
                      <li class="sweevit-product__option-perk">
                        {{- 'icon-checkmark.svg' | inline_asset_content -}}
                        <span>{{ section.settings.perk_1 | escape }}</span>
                      </li>
                    {%- endif -%}
                    {%- if section.settings.perk_2 != blank -%}
                      <li class="sweevit-product__option-perk">
                        {{- 'icon-checkmark.svg' | inline_asset_content -}}
                        <span>{{ section.settings.perk_2 | escape }}</span>
                      </li>
                    {%- endif -%}
                    {%- if section.settings.perk_3 != blank -%}
                      <li class="sweevit-product__option-perk">
                        {{- 'icon-checkmark.svg' | inline_asset_content -}}
                        <span>{{ section.settings.perk_3 | escape }}</span>
                      </li>
                    {%- endif -%}
                  </ul>
                {%- endif -%}
              </label>
            {%- endif -%}
          </div>

          <div class="sweevit-pdp__purchase-box">
          <product-form class="product-form" data-section-id="{{ section.id }}">
            <div class="product-form__error-message-wrapper" role="alert" hidden>
              <span class="product-form__error-message"></span>
            </div>

            {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
              <input
                type="hidden"
                name="id"
                value="{{ current_variant.id }}"
                class="product-variant-id"
                {% if current_variant.available == false %}disabled{% endif %}
              >
              <input type="hidden" value="" data-selling-plan-input>

              <div class="sweevit-product__purchase sweevit-pdp__purchase">
                <div class="sweevit-product__quantity sweevit-pdp__quantity">
                  <button
                    type="button"
                    class="sweevit-product__qty-btn"
                    data-quantity-minus
                    aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}"
                  >
                    &minus;
                  </button>
                  <input
                    class="sweevit-product__qty-input"
                    type="number"
                    name="quantity"
                    value="1"
                    min="1"
                    {% if current_variant.quantity_rule.max != null %}
                      max="{{ current_variant.quantity_rule.max }}"
                    {% endif %}
                    step="1"
                    data-quantity-input
                    aria-label="{{ 'products.product.quantity.input_label' | t: product: product.title | escape }}"
                  >
                  <button
                    type="button"
                    class="sweevit-product__qty-btn"
                    data-quantity-plus
                    aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}"
                  >
                    +
                  </button>
                </div>

                <button
                  type="submit"
                  name="add"
                  class="sweevit-product__atc sweevit-pdp__atc"
                  {% if current_variant.available == false %}disabled{% endif %}
                >
                  <span>
                    {{- section.settings.button_label | escape -}}
                    — <span data-atc-price>{% if default_option == 'subscribe' %}{{ subscribe_price }}{% else %}{{ onetime_price }}{% endif %}</span>
                  </span>
                  {%- render 'loading-spinner' -%}
                </button>
              </div>
            {%- endform -%}
          </product-form>

          <div class="sweevit-pdp__trust">
            {%- if section.settings.secure_checkout_text != blank -%}
              <span class="sweevit-pdp__trust-item">
                {{- 'icon-lock.svg' | inline_asset_content -}}
                {{ section.settings.secure_checkout_text | escape }}
              </span>
            {%- endif -%}
            {%- if section.settings.guarantee_text != blank -%}
              <span class="sweevit-pdp__trust-item">
                {{- 'icon-return.svg' | inline_asset_content -}}
                {{ section.settings.guarantee_text | escape }}
              </span>
            {%- endif -%}
            {%- if section.settings.shipping_text != blank -%}
              <span class="sweevit-pdp__trust-item">
                {{- 'icon-truck.svg' | inline_asset_content -}}
                {{ section.settings.shipping_text | escape }}
              </span>
            {%- endif -%}
          </div>

          {%- if section.settings.cert_1 != blank or section.settings.cert_2 != blank or section.settings.cert_3 != blank or section.settings.cert_4 != blank -%}
            <div class="sweevit-pdp__certs">
              {%- for i in (1..4) -%}
                {%- capture cert_key -%}cert_{{ i }}{%- endcapture -%}
                {%- assign cert_value = section.settings[cert_key] -%}
                {%- if cert_value != blank -%}
                  <span class="sweevit-pdp__cert">
                    {{- 'icon-checkmark.svg' | inline_asset_content -}}
                    {{ cert_value | escape }}
                  </span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </sweevit-product-showcase>
</section>

<script src="{{ 'sweevit-product-showcase.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

