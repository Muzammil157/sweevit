    },
    {
      "type": "text",
      "id": "perk_1",
      "label": "Variant perk 1",
      "default": "Free shipping"
    },
    {
      "type": "text",
      "id": "perk_2",
      "label": "Variant perk 2",
      "default": "Cancel anytime"
    },
    {
      "type": "text",
      "id": "perk_3",
      "label": "Variant perk 3",
      "default": "Priority access"
    },
    {
      "type": "header",
      "content": "Purchase options"
    },
    {
      "type": "checkbox",
      "id": "show_subscribe",
      "label": "Show subscribe option",
      "default": true
    },
    {
      "type": "select",
