      "label": "Default option",
      "options": [
        { "value": "subscribe", "label": "Subscribe & save" },
        { "value": "onetime", "label": "One-time purchase" }
      ],
      "default": "subscribe"
    },
    {
      "type": "text",
      "id": "one_time_label",
      "label": "One-time label",
      "default": "One time purchase"
    },
    {
      "type": "text",
      "id": "subscribe_label",
      "label": "Subscribe label",
      "default": "Subscribe & Save 10%"
    },
    {
      "type": "text",
      "id": "subscribe_perk",
      "label": "Subscribe perk",
      "default": "Delivered Monthly"
    },
    {
      "type": "text",
      "id": "subscribe_price_fallback",
      "label": "Subscribe price fallback",
      "default": "$31.20"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show Buy it now",
      "default": true
    },
    {
      "type": "text",
      "id": "secure_checkout_text",
      "label": "Secure checkout",
      "default": "Secure checkout"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "30-day money-back guarantee"
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping text",
      "default": "Free shipping over $35"
    },
    {
      "type": "text",
      "id": "cert_1",
      "label": "Certification 1",
      "default": "Non-GMO"
    },
    {
      "type": "text",
      "id": "cert_2",
      "label": "Certification 2",
      "default": "Gluten-Free"
    },
    {
      "type": "text",
      "id": "cert_3",
      "label": "Certification 3",
      "default": "Vegan"
    },
    {
      "type": "text",
      "id": "cert_4",
      "label": "Certification 4",
      "default": "Lab Tested"
    },
    {
      "type": "header",
      "content": "Info paragraphs"
    },
    {
      "type": "text",
      "id": "effect_heading",
      "label": "Effect heading",
      "default": "Effect"
    },
    {
      "type": "richtext",
      "id": "effect_text",
      "label": "Effect text",
      "default": "<p>delivers a noticeable, natural sense of euphoria and relaxation without alcohol or THC. Most people feel the effects within about 45 minutes. One can feels calming and uplifting. Two cans feel more social and euphoric. The experience is warm, clear-headed, and controlled, not overwhelming or foggy. Everyone's tolerance is different, so we recommend starting with one and seeing how you feel</p>"
    },
    {
      "type": "text",
      "id": "ingredients_heading",
      "label": "Ingredients heading",
      "default": "Ingredients"
    },
    {
      "type": "richtext",
