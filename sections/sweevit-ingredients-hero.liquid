{{ 'sweevit-design-system.css' | asset_url | stylesheet_tag }}
{{ 'section-sweevit-ingredients-hero.css' | asset_url | stylesheet_tag }}
{{ 'section-sweevit-ingredients-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #SweevitIngredientsHero-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #SweevitIngredientsHero-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="SweevitIngredientsHero-{{ section.id }}"
  class="sweevit-ingredients-hero"
>
  <div class="sweevit-ingredients-hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="sweevit-ingredients-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank -%}
      <h1 class="sweevit-ingredients-hero__heading">
        {%- if section.settings.heading_line_1 != blank -%}
          <span class="sweevit-ingredients-hero__heading-line">{{ section.settings.heading_line_1 | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading_line_2 != blank -%}
          <span class="sweevit-ingredients-hero__heading-line">{{ section.settings.heading_line_2 | escape }}</span>
        {%- endif -%}
      </h1>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="sweevit-ingredients-hero__description">{{ section.settings.description | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ingredients Hero",
  "tag": "section",
  "class": "section-sweevit-ingredients-hero",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "TRANSPARENCY FIRST"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Every ingredient."
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "Fully disclosed."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "The proprietary blend of natural fibers, plant-based acids, and your daily ritual, and vitamin-rich."
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 108
    }
  ],
  "presets": [
    {
      "name": "Ingredients Hero"
    }
  ]
}
{% endschema %}
