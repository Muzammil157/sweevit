{{ 'section-sweevit-reviews-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #SweevitJudgemeAllReviews-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #SweevitJudgemeAllReviews-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="SweevitJudgemeAllReviews-{{ section.id }}"
  class="sweevit-judgeme-all-reviews"
>
  <div class="sweevit-judgeme-all-reviews__inner">
    {% render 'judgeme-all-reviews' %}
  </div>
</section>

{% schema %}
{
  "name": "Judge.me all reviews",
  "tag": "section",
  "class": "section-sweevit-judgeme-all-reviews",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Judge.me all reviews"
    }
  ]
}
{% endschema %}
