{{ 'sweevit-design-system.css' | asset_url | stylesheet_tag }}
{{ 'section-sweevit-about-story.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign video_url = section.settings.video_url | strip
  assign has_video = false
  assign video_embed_url = blank
  assign video_is_file = false

  if video_url != blank
    assign has_video = true
    assign video_lower = video_url | downcase

    if video_lower contains 'youtube.com/watch'
      assign video_id = video_url | split: 'v=' | last | split: '&' | first
      assign video_embed_url = 'https://www.youtube.com/embed/' | append: video_id | append: '?rel=0&modestbranding=1'
    elsif video_lower contains 'youtu.be/'
      assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first
      assign video_embed_url = 'https://www.youtube.com/embed/' | append: video_id | append: '?rel=0&modestbranding=1'
    elsif video_lower contains 'youtube.com/shorts/'
      assign video_id = video_url | split: 'shorts/' | last | split: '?' | first
      assign video_embed_url = 'https://www.youtube.com/embed/' | append: video_id | append: '?rel=0&modestbranding=1'
    elsif video_lower contains 'vimeo.com/'
      assign video_id = video_url | split: 'vimeo.com/' | last | split: '/' | last | split: '?' | first
      assign video_embed_url = 'https://player.vimeo.com/video/' | append: video_id
    elsif video_lower contains '.mp4' or video_lower contains '.webm' or video_lower contains '.ogg'
      assign video_is_file = true
    endif
  endif
-%}

{%- style -%}
  #SweevitAboutStory-{{ section.id }} {
    --sweevit-about-story-bg: {{ section.settings.background_gradient }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #SweevitAboutStory-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="SweevitAboutStory-{{ section.id }}"
  class="sweevit-about-story"
>
  <div class="sweevit-about-story__inner">
    <div class="sweevit-about-story__grid">
      <div class="sweevit-about-story__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sweevit-about-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="sweevit-about-story__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.show_rating -%}
          <div class="sweevit-about-story__rating">
            <span class="sweevit-about-story__stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                {{- 'icon-star-filled.svg' | inline_asset_content -}}
              {%- endfor -%}
            </span>
            <span class="sweevit-about-story__rating-text">
              {{ section.settings.rating_value | escape }}
              {%- if section.settings.review_count != blank -%}
                · {{ section.settings.review_count | escape }}
                {%- if section.settings.review_label != blank -%}
                  {{ section.settings.review_label | escape }}
                {%- endif -%}
              {%- endif -%}
            </span>
          </div>
        {%- endif -%}

        <article class="sweevit-about-story__card">
          <div class="sweevit-about-story__card-logo">
            {%- if section.settings.brand_logo != blank -%}
              {{
                section.settings.brand_logo
                | image_url: width: 240
                | image_tag:
                  class: 'sweevit-about-story__card-logo-image',
                  loading: 'lazy',
                  widths: '120, 240',
                  sizes: '120px',
                  alt: shop.name
              }}
            {%- else -%}
              <span class="sweevit-about-story__card-logo-text">{{ section.settings.brand_name | default: 'sweevit' | escape }}</span>
            {%- endif -%}
          </div>

          {%- if section.settings.card_text != blank -%}
            <div class="sweevit-about-story__card-text">
              {{ section.settings.card_text }}
            </div>
          {%- endif -%}
        </article>

        {%- if section.blocks.size > 0 -%}
          <ul class="sweevit-about-story__press" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'press_logo' -%}
                <li class="sweevit-about-story__press-item" {{ block.shopify_attributes }}>
                  {%- if block.settings.logo != blank -%}
                    {%- assign press_alt = block.settings.logo_text | default: 'Press logo' | escape -%}
                    {{
                      block.settings.logo
                      | image_url: width: 240
                      | image_tag:
                        class: 'sweevit-about-story__press-image',
                        loading: 'lazy',
                        widths: '120, 240',
                        sizes: '120px',
                        alt: press_alt
                    }}
                  {%- elsif block.settings.logo_text != blank -%}
                    {%- assign logo_upper = block.settings.logo_text | upcase -%}
                    <span class="sweevit-about-story__press-text{% if logo_upper == 'VOGUE' %} sweevit-about-story__press-text--vogue{% endif %}">
                      {{ block.settings.logo_text | escape }}
                    </span>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="sweevit-about-story__media">
        <div
          class="sweevit-about-story__video{% if has_video %} sweevit-about-story__video--ready{% endif %}"
          data-about-story-video
        >
          {%- if has_video and video_embed_url != blank -%}
            <iframe
              class="sweevit-about-story__iframe"
              src="{{ video_embed_url }}"
              title="{{ section.settings.heading | default: 'About Sweevit' | escape }}"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          {%- elsif has_video and video_is_file -%}
            <video
              class="sweevit-about-story__file"
              controls
              playsinline
              {% if section.settings.video_poster != blank %}
                poster="{{ section.settings.video_poster | image_url: width: 1052 }}"
              {% endif %}
              src="{{ video_url }}"
            ></video>
          {%- else -%}
            <div class="sweevit-about-story__placeholder">
              {%- if section.settings.video_poster != blank -%}
                {{
                  section.settings.video_poster
                  | image_url: width: 1052
                  | image_tag:
                    class: 'sweevit-about-story__poster',
                    loading: 'lazy',
                    widths: '400, 600, 800, 1052',
                    sizes: '(min-width: 990px) 526px, 100vw',
                    alt: section.settings.heading | default: 'About Sweevit video'
                }}
              {%- endif -%}
              <span class="sweevit-about-story__play" aria-hidden="true">
                <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="64" height="64" rx="14" fill="#FF0033"/>
                  <path d="M26 20.5V43.5L44 32L26 20.5Z" fill="white"/>
                </svg>
              </span>
              {%- if section.settings.video_url == blank -%}
                <span class="visually-hidden">Video placeholder — add a video URL in the theme editor</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sweevit about story",
  "tag": "section",
  "class": "section-sweevit-about-story",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Subheading",
      "default": "ABOUT US"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We Believe Wellness Should Feel Effortless."
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Rating value",
      "default": "4.9 / 5.0"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "default": "217"
    },
    {
      "type": "text",
      "id": "review_label",
      "label": "Review label",
      "default": "Reviews"
    },
    {
      "type": "header",
      "content": "Story card"
    },
    {
      "type": "image_picker",
      "id": "brand_logo",
      "label": "Brand logo"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name fallback",
      "default": "sweevit"
    },
    {
      "type": "richtext",
      "id": "card_text",
      "label": "Card text",
      "default": "<p>Sweevit started with a simple belief: wellness should feel like a ritual, not a chore. We wanted something that fits into real life — mornings, conversations, quiet moments of focus — without the noise of complicated routines.</p><p>Our mission is to bring ancient wisdom into modern living. Inspired by Himalayan mad honey and crafted for everyday clarity, energy, and balance.</p><p>Because feeling good shouldn't mean choosing between health and enjoyment. With Sweevit, you get both — naturally.</p>"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "info": "Paste a YouTube, Vimeo, or direct .mp4 link. Leave blank to show the placeholder."
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Video poster / placeholder image"
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "text",
      "id": "background_gradient",
      "label": "Background gradient",
      "default": "linear-gradient(135deg, #E8E8F5 0%, #F5F2FA 28.57%, #EBF5FC 50%, #F2EDE6 71.43%)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "press_logo",
      "name": "Press logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "logo_text",
          "label": "Logo text fallback",
          "default": "Forbes"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sweevit about story",
      "blocks": [
        { "type": "press_logo", "settings": { "logo_text": "Forbes" } },
        { "type": "press_logo", "settings": { "logo_text": "Women's Health" } },
        { "type": "press_logo", "settings": { "logo_text": "VOGUE" } },
        { "type": "press_logo", "settings": { "logo_text": "Esquire" } }
      ]
    }
  ]
}
{% endschema %}
