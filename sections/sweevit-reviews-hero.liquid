{{ 'sweevit-design-system.css' | asset_url | stylesheet_tag }}
{{ 'section-sweevit-reviews-hero.css' | asset_url | stylesheet_tag }}
{{ 'section-sweevit-reviews-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #SweevitReviewsHero-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #SweevitReviewsHero-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign jm_count = shop.metafields.judgeme.all_reviews_count | default: 0
  assign jm_rating = shop.metafields.judgeme.all_reviews_rating | default: 0
  assign rating_display = jm_rating | round: 1

  if jm_count > 0
    assign heading_line_1 = jm_count | append: ' Reviews.'
    assign rating_summary = rating_display | append: ' / 5.0 · ' | append: jm_count | append: ' Reviews'
    assign verified_text = 'Based on ' | append: jm_count | append: ' verified reviews'
  else
    assign heading_line_1 = section.settings.heading_line_1
    assign rating_summary = section.settings.rating_summary
    assign verified_text = section.settings.verified_text
    if section.settings.rating_value != blank
      assign rating_display = section.settings.rating_value
    endif
  endif
-%}

<section
  id="SweevitReviewsHero-{{ section.id }}"
  class="sweevit-reviews-hero"
>
  <div class="sweevit-reviews-hero__inner">
    <div class="sweevit-reviews-hero__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sweevit-reviews-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if heading_line_1 != blank or section.settings.heading_line_2 != blank -%}
        <h1 class="sweevit-reviews-hero__heading">
          {%- if heading_line_1 != blank -%}
            <span class="sweevit-reviews-hero__heading-line">{{ heading_line_1 | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading_line_2 != blank -%}
            <span class="sweevit-reviews-hero__heading-line">{{ section.settings.heading_line_2 | escape }}</span>
          {%- endif -%}
        </h1>
      {%- endif -%}
    </div>

    <div class="sweevit-reviews-hero__summary">
      <div class="sweevit-reviews-hero__rating-row">
        {%- if rating_display != blank -%}
          <p class="sweevit-reviews-hero__rating-value">{{ rating_display | escape }}</p>
        {%- endif -%}

        <div class="sweevit-reviews-hero__rating-meta">
          <div class="sweevit-reviews-hero__stars" aria-hidden="true">
            {%- if jm_rating > 0 -%}
              <span class="jdgm-widget jdgm-all-reviews-rating" data-score="{{ jm_rating | round: 2 }}"></span>
            {%- else -%}
              {%- for i in (1..5) -%}
                {{- 'icon-star-filled.svg' | inline_asset_content -}}
              {%- endfor -%}
            {%- endif -%}
          </div>

          {%- if rating_summary != blank -%}
            <p class="sweevit-reviews-hero__rating-summary">{{ rating_summary | escape }}</p>
          {%- endif -%}

          {%- if verified_text != blank -%}
            <p class="sweevit-reviews-hero__verified-text">{{ verified_text | escape }}</p>
          {%- endif -%}
        </div>
      </div>

      <div class="sweevit-reviews-hero__bars-card">
        {%- if shop.metafields.judgeme.all_reviews_header != blank -%}
          <div class="sweevit-reviews-hero__judgeme-header">
            {{ shop.metafields.judgeme.all_reviews_header }}
          </div>
        {%- else -%}
          <div class="sweevit-reviews-hero__bars" aria-label="Rating distribution">
            {%- for i in (1..5) reversed -%}
              {%- assign bar_key = 'bar_' | append: i | append: '_percent' -%}
              {%- assign bar_percent = section.settings[bar_key] | default: 0 -%}
              <div class="sweevit-reviews-hero__bar-row">
                <span class="sweevit-reviews-hero__bar-label">{{ i }}★</span>
                <span class="sweevit-reviews-hero__bar-track" aria-hidden="true">
                  <span class="sweevit-reviews-hero__bar-fill" style="width: {{ bar_percent }}%;"></span>
                </span>
                <span class="sweevit-reviews-hero__bar-percent">{{ bar_percent }}%</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews Hero",
  "tag": "section",
  "class": "section-sweevit-reviews-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CUSTOMER REVIEWS"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "217 Reviews."
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "One Ritual."
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Rating value",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "rating_summary",
      "label": "Rating summary",
      "default": "4.9 / 5.0 · 217 Reviews"
    },
    {
      "type": "text",
      "id": "verified_text",
      "label": "Verified reviews text",
      "default": "Based on 217 verified reviews"
    },
    {
      "type": "range",
      "id": "bar_5_percent",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "5 star bar",
      "default": 88
    },
    {
      "type": "range",
      "id": "bar_4_percent",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "4 star bar",
      "default": 9
    },
    {
      "type": "range",
      "id": "bar_3_percent",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "3 star bar",
      "default": 2
    },
    {
      "type": "range",
      "id": "bar_2_percent",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "2 star bar",
      "default": 1
    },
    {
      "type": "range",
      "id": "bar_1_percent",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "1 star bar",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Reviews Hero"
    }
  ]
}
{% endschema %}