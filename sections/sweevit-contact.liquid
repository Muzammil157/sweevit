      "default": "Questions about your order, our products, or our guarantee? The team typically responds within 24 hours."
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "form_label",
      "label": "Form section label",
      "default": "Send a message"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label",
      "default": "Full name"
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name placeholder",
      "default": "Your name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "order_label",
      "label": "Order number label",
      "default": "Order number (optional)"
    },
    {
      "type": "text",
      "id": "order_placeholder",
      "label": "Order number placeholder",
      "default": "e.g. #1234"
    },
    {
      "type": "text",
      "id": "subject_label",
      "label": "Subject label",
      "default": "Subject"
    },
    {
      "type": "text",
      "id": "subject_placeholder",
      "label": "Subject placeholder",
      "default": "How can we help?"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label",
      "default": "Message"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Message placeholder",
      "default": "Tell us more..."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit button label",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message"
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message"
    },
    {
      "type": "header",
      "content": "Reach cards"
    },
    {
      "type": "text",
      "id": "reach_label",
      "label": "Reach section label",
      "default": "Other ways to reach us"
    },
    {
      "type": "header",
      "content": "Visit us"
    },
    {
      "type": "text",
      "id": "visit_label",
      "label": "Visit section label",
      "default": "Visit us"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "123 Wellness Ave, Suite 789 — XYZ Country",
      "info": "Displayed on the page and used to show the Google Map automatically."
    },
    {
      "type": "text",
      "id": "map_location",
