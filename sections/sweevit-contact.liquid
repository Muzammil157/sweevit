{{ 'sweevit-design-system.css' | asset_url | stylesheet_tag }}
{{ 'section-sweevit-contact.css' | asset_url | stylesheet_tag }}

<section id="SweevitContact-{{ section.id }}" class="sweevit-contact">
  {%- comment -%} Hero {%- endcomment -%}
  <div class="sweevit-contact__hero">
    <div class="sweevit-contact__hero-bg" aria-hidden="true"></div>
    <div class="sweevit-contact__hero-inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sweevit-contact__eyebrow sweevit-contact__eyebrow--mobile">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.eyebrow_desktop != blank -%}
        <p class="sweevit-contact__eyebrow sweevit-contact__eyebrow--desktop">{{ section.settings.eyebrow_desktop | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="sweevit-contact__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="sweevit-contact__description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Form + Reach cards {%- endcomment -%}
  <div class="sweevit-contact__main">
    <div class="sweevit-contact__main-inner">
      <div class="sweevit-contact__form-col">
        <p class="sweevit-contact__section-label">{{ section.settings.form_label | escape }}</p>

        {%- form 'contact', id: 'SweevitContactForm', class: 'sweevit-contact__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="sweevit-contact__form-status sweevit-contact__form-status--success" tabindex="-1" autofocus>
              {{ section.settings.success_message | default: "Thanks for contacting us. We'll get back to you as soon as possible." | escape }}
            </p>
          {%- elsif form.errors -%}
            <p class="sweevit-contact__form-status sweevit-contact__form-status--error" role="alert" tabindex="-1" autofocus>
              {{ section.settings.error_message | default: 'Please correct the errors below and try again.' | escape }}
            </p>
          {%- endif -%}

          <div class="sweevit-contact__field">
            <label class="sweevit-contact__label" for="SweevitContactForm-name">{{ section.settings.name_label | escape }}</label>
            <input
              class="sweevit-contact__input"
              autocomplete="name"
              type="text"
              id="SweevitContactForm-name"
              name="contact[{{ 'templates.contact.form.name' | t }}]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder="{{ section.settings.name_placeholder | escape }}"
            >
          </div>

          <div class="sweevit-contact__field">
            <label class="sweevit-contact__label" for="SweevitContactForm-email">{{ section.settings.email_label | escape }}</label>
            <input
              class="sweevit-contact__input{% if form.errors contains 'email' %} sweevit-contact__input--error{% endif %}"
              autocomplete="email"
              type="email"
              id="SweevitContactForm-email"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
              placeholder="{{ section.settings.email_placeholder | escape }}"
            >
          </div>

          <div class="sweevit-contact__field">
            <label class="sweevit-contact__label" for="SweevitContactForm-order">{{ section.settings.order_label | escape }}</label>
            <input
              class="sweevit-contact__input"
              type="text"
              id="SweevitContactForm-order"
              name="contact[Order Number]"
              placeholder="{{ section.settings.order_placeholder | escape }}"
            >
          </div>

          <div class="sweevit-contact__field">
            <label class="sweevit-contact__label" for="SweevitContactForm-subject">{{ section.settings.subject_label | escape }}</label>
            <input
              class="sweevit-contact__input"
              type="text"
              id="SweevitContactForm-subject"
              name="contact[Subject]"
              placeholder="{{ section.settings.subject_placeholder | escape }}"
            >
          </div>

          <div class="sweevit-contact__field">
            <label class="sweevit-contact__label" for="SweevitContactForm-body">{{ section.settings.message_label | escape }}</label>
            <textarea
              class="sweevit-contact__input sweevit-contact__textarea"
              rows="5"
              id="SweevitContactForm-body"
              name="contact[body]"
              placeholder="{{ section.settings.message_placeholder | escape }}"
            >{{- form.body -}}</textarea>
          </div>

          <button type="submit" class="sweevit-contact__submit">
            {{ section.settings.button_label | escape }}
          </button>
        {%- endform -%}
      </div>

      <div class="sweevit-contact__reach-col">
        <p class="sweevit-contact__section-label">{{ section.settings.reach_label | escape }}</p>

        {%- if section.blocks.size > 0 -%}
          <div class="sweevit-contact__cards">
            {%- for block in section.blocks -%}
              {%- liquid
                assign card_icon = 'Vector.png'
                case block.settings.icon
                  when 'email'
                    assign card_icon = 'Vector.png'
                  when 'chat'
                    assign card_icon = 'gridicons_chat.png'
                  when 'shipping'
                    assign card_icon = 'Vector-1.png'
                  when 'partnership'
                    assign card_icon = 'mdi_partnership.png'
                endcase
              -%}
              <article class="sweevit-contact__card" {{ block.shopify_attributes }}>
                <div class="sweevit-contact__card-icon-wrap">
                  <img
                    src="{{ card_icon | asset_url }}"
                    alt=""
                    class="sweevit-contact__card-icon"
                    width="20"
                    height="20"
                    loading="lazy"
                  >
                </div>
                <div class="sweevit-contact__card-content">
                  {%- if block.settings.title != blank -%}
                    <h3 class="sweevit-contact__card-title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.detail != blank -%}
                    <p class="sweevit-contact__card-detail">{{ block.settings.detail | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <p class="sweevit-contact__card-desc">{{ block.settings.description | escape }}</p>
                  {%- endif -%}
                </div>
              </article>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} Visit us {%- endcomment -%}
  <div class="sweevit-contact__visit">
    <div class="sweevit-contact__visit-inner">
      <p class="sweevit-contact__section-label">{{ section.settings.visit_label | escape }}</p>

      {%- if section.settings.address != blank -%}
        <p class="sweevit-contact__address">{{ section.settings.address | escape }}</p>
      {%- endif -%}

      <div class="sweevit-contact__map">
        {%- assign map_query = section.settings.map_location | strip -%}
        {%- if map_query == blank -%}
          {%- assign map_query = section.settings.address | strip -%}
        {%- endif -%}

        {%- if map_query != blank -%}
          {%- assign map_title = section.settings.map_alt | default: map_query | escape -%}
          <sweevit-contact-map
            class="sweevit-contact__map-embed"
            data-query="{{ map_query | escape }}"
            {%- if section.settings.map_latitude != blank and section.settings.map_longitude != blank -%}
              data-lat="{{ section.settings.map_latitude | escape }}"
              data-lng="{{ section.settings.map_longitude | escape }}"
            {%- endif -%}
          >
            <iframe
              data-map-iframe
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="{{ map_title }}"
            ></iframe>
          </sweevit-contact-map>
        {%- elsif section.settings.map_image != blank -%}
          {%- assign map_alt = section.settings.map_alt | default: 'Map location' | escape -%}
          {{
            section.settings.map_image
            | image_url: width: 1200
            | image_tag:
              class: 'sweevit-contact__map-image',
              widths: '400, 600, 900, 1200',
              sizes: '(min-width: 990px) 100vw, 100vw',
              alt: map_alt,
              loading: 'lazy'
          }}
        {%- else -%}
          <div class="sweevit-contact__map-placeholder" aria-hidden="true">
            <span>{{ section.settings.map_placeholder | escape }}</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'sweevit-contact-map.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Sweevit Contact",
  "tag": "section",
  "class": "section-sweevit-contact",
  "settings": [
    {
      "type": "header",
