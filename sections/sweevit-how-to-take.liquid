{{ 'sweevit-design-system.css' | asset_url | stylesheet_tag }}
{{ 'section-sweevit-how-to-take.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #SweevitHowToTake-{{ section.id }} {
    --sweevit-how-to-bg: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #SweevitHowToTake-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="SweevitHowToTake-{{ section.id }}"
  class="sweevit-how-to-take"
>
  <div class="sweevit-how-to-take__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="sweevit-how-to-take__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sweevit-how-to-take__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="sweevit-how-to-take__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="sweevit-how-to-take__grid">
        {%- for block in section.blocks -%}
          <article class="sweevit-how-to-take__step" {{ block.shopify_attributes }}>
            {%- if block.settings.number != blank -%}
              <p class="sweevit-how-to-take__number" aria-hidden="true">{{ block.settings.number | escape }}</p>
            {%- else -%}
              <p class="sweevit-how-to-take__number" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
            {%- endif -%}

            <div class="sweevit-how-to-take__content">
              {%- if block.settings.title != blank -%}
                <h3 class="sweevit-how-to-take__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="sweevit-how-to-take__text">{{ block.settings.description | escape }}</p>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sweevit How To Take",
  "tag": "section",
  "class": "section-sweevit-how-to-take",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE RITUAL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How To Take Sweevit."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Take two gummies"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Each morning, take two Sweevit gummies as part of your daily routine."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sweevit How To Take",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "number": "01",
            "title": "Take two gummies",
            "description": "Each morning, take two Sweevit gummies as part of your daily routine."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "02",
            "title": "Pair with your morning",
            "description": "Enjoy with breakfast, coffee, or water — no special timing required."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "03",
            "title": "Stay consistent",
            "description": "Most people notice improved clarity and energy within 7–14 days."
          }
        }
      ]
    }
  ]
}
{% endschema %}
