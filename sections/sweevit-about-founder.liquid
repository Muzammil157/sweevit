{{ 'sweevit-design-system.css' | asset_url | stylesheet_tag }}
{{ 'section-sweevit-about-founder.css' | asset_url | stylesheet_tag }}

<section
  id="SweevitAboutFounder-{{ section.id }}"
  class="sweevit-about-founder"
>
  <div class="sweevit-about-founder__inner">
    <div class="sweevit-about-founder__grid">
      <div class="sweevit-about-founder__media">
        {%- if section.settings.image != blank -%}
          {%- assign founder_alt = section.settings.image.alt | default: section.settings.placeholder_label | escape -%}
          {{
            section.settings.image
            | image_url: width: 960
            | image_tag:
              class: 'sweevit-about-founder__image',
              widths: '480, 720, 960',
              sizes: '(min-width: 990px) 480px, 100vw',
              alt: founder_alt,
              width: 480,
              height: 400,
              loading: 'lazy'
          }}
        {%- else -%}
          <div class="sweevit-about-founder__placeholder">
            <span class="sweevit-about-founder__placeholder-text">
              {{ section.settings.placeholder_label | escape }}
            </span>
          </div>
        {%- endif -%}
      </div>

      <div class="sweevit-about-founder__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sweevit-about-founder__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="sweevit-about-founder__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="sweevit-about-founder__text">{{ section.settings.description }}</div>
        {%- endif -%}

        {%- if section.settings.signoff != blank -%}
          <p class="sweevit-about-founder__signoff">{{ section.settings.signoff | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Founder",
  "tag": "section",
  "class": "section-sweevit-about-founder",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FOUNDER'S NOTE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why we built Sweevit."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Paragraph",
      "default": "<p>Like many of you, we tried every supplement, stack, and shortcut. Nothing stuck. Sweevit was born from wanting a single daily ritual we could actually look forward to — one gummy, every morning, done.</p>"
    },
    {
      "type": "text",
      "id": "signoff",
      "label": "Sign-off",
      "default": "— The Sweevit Team"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder portrait"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder label",
      "default": "Founder Portrait"
    }
  ],
  "presets": [
    {
      "name": "About Founder"
    }
  ]
}
{% endschema %}
