{{ 'sweevit-design-system.css' | asset_url | stylesheet_tag }}
{{ 'section-sweevit-product-showcase.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign product = section.settings.product
  if product == blank
    assign product = all_products['sweevit-functional-gummies']
  endif
  assign heading = section.settings.heading
  assign subtitle = section.settings.subheading
  if product != blank
    assign current_variant = product.selected_or_first_available_variant
    assign onetime_price = current_variant.price | money
    assign first_selling_plan = nil
    assign subscribe_price = blank

    for allocation in current_variant.selling_plan_allocations
      assign first_selling_plan = allocation.selling_plan
      assign subscribe_price = allocation.price | money
      break
    endfor

    if subscribe_price == blank
      if section.settings.subscribe_price_fallback != blank
        assign subscribe_price = section.settings.subscribe_price_fallback
      else
        assign subscribe_cents = current_variant.price | times: 0.8 | round
        assign subscribe_price = subscribe_cents | money
      endif
    endif

    if heading == blank
      assign heading = product.title
    endif
  else
    assign onetime_price = section.settings.one_time_price_fallback
    assign subscribe_price = section.settings.subscribe_price_fallback
    if heading == blank
      assign heading = 'Sweevit Functional Gummies'
    endif
    if subtitle == blank
      assign subtitle = 'Focus, Energy & Wellness'
    endif
  endif

  assign product_form_id = 'sweevit-product-form-' | append: section.id
  assign default_option = section.settings.default_purchase_option
  assign show_subscribe = section.settings.show_subscribe
-%}

{%- style -%}
  #SweevitProduct-{{ section.id }} {
    --sweevit-product-bg: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #SweevitProduct-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="SweevitProduct-{{ section.id }}"
  class="sweevit-product"
>
  <sweevit-product-showcase class="sweevit-product__inner">
    <div class="sweevit-product__grid">
      <div class="sweevit-product__media">
        <div class="sweevit-product__media-frame">
          {%- if section.settings.enable_custom_image and section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                class: 'sweevit-product__image',
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200',
                sizes: '(min-width: 990px) 628px, 100vw',
                alt: heading
            }}
          {%- else -%}
            <img
              src="{{ 'MiniPouch-product.png' | asset_url }}"
              class="sweevit-product__image"
              loading="lazy"
              width="628"
              height="569"
              alt="{{ heading | escape }}"
            >
          {%- endif -%}
        </div>
      </div>

      <div class="sweevit-product__content">
        {%- if heading != blank -%}
          <h2 class="sweevit-product__title">{{ heading | escape }}</h2>
        {%- endif -%}

        {%- if subtitle != blank -%}
          <p class="sweevit-product__subtitle">{{ subtitle | escape }}</p>
        {%- endif -%}

        {%- if section.settings.show_rating -%}
          <div class="sweevit-product__rating">
            <span class="sweevit-product__stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                {{- 'icon-star.svg' | inline_asset_content -}}
              {%- endfor -%}
            </span>
            <span class="sweevit-product__rating-text">
              {{ section.settings.rating_value | escape }}
              ({{ section.settings.review_count | escape }} {{ section.settings.review_label | escape }})
            </span>
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="sweevit-product__highlights">
            {%- for block in section.blocks -%}
              <article class="sweevit-product__highlight" {{ block.shopify_attributes }}>
                <div class="sweevit-product__highlight-icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'energy' -%}
                      {{- 'ix_electrical-energy-filled.svg' | inline_asset_content -}}
                    {%- when 'wellness' -%}
                      {{- 'wellness.svg' | inline_asset_content -}}
                    {%- else -%}
                      {{- 'focus.svg' | inline_asset_content -}}
                  {%- endcase -%}
                </div>
                <div class="sweevit-product__highlight-body">
                  {%- if block.settings.title != blank -%}
                    <h3 class="sweevit-product__highlight-title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <p class="sweevit-product__highlight-text">{{ block.settings.description | escape }}</p>
                  {%- endif -%}
                </div>
              </article>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="sweevit-product__options" role="radiogroup" aria-label="Purchase option">
          <label
            class="sweevit-product__option{% if default_option == 'onetime' %} is-active{% endif %}"
            data-purchase-option
            tabindex="0"
          >
            <input
              type="radio"
              name="purchase-option-{{ section.id }}"
              value="onetime"
              {% if default_option == 'onetime' %}checked{% endif %}
            >
            <span class="sweevit-product__option-row">
              <span class="sweevit-product__option-left">
                <span class="sweevit-product__option-radio" aria-hidden="true"></span>
                <span class="sweevit-product__option-label">{{ section.settings.one_time_label | escape }}</span>
              </span>
              <span class="sweevit-product__option-price" data-onetime-price>{{ onetime_price }}</span>
            </span>
          </label>

          {%- if show_subscribe -%}
            <label
              class="sweevit-product__option{% if default_option == 'subscribe' %} is-active{% endif %}"
              data-purchase-option
              {% if first_selling_plan != nil %}
                data-selling-plan-id="{{ first_selling_plan.id }}"
              {% endif %}
              tabindex="0"
            >
              <input
                type="radio"
                name="purchase-option-{{ section.id }}"
                value="subscribe"
                {% if default_option == 'subscribe' %}checked{% endif %}
              >
              <span class="sweevit-product__option-row">
                <span class="sweevit-product__option-left">
                  <span class="sweevit-product__option-radio" aria-hidden="true"></span>
                  <span class="sweevit-product__option-label">{{ section.settings.subscribe_label | escape }}</span>
                </span>
                <span class="sweevit-product__option-price" data-subscribe-price>{{ subscribe_price }}</span>
              </span>

              {%- if section.settings.perk_1 != blank or section.settings.perk_2 != blank or section.settings.perk_3 != blank -%}
                <ul class="sweevit-product__option-perks">
                  {%- if section.settings.perk_1 != blank -%}
                    <li class="sweevit-product__option-perk">
                      {{- 'icon-checkmark.svg' | inline_asset_content -}}
                      <span>{{ section.settings.perk_1 | escape }}</span>
                    </li>
                  {%- endif -%}
                  {%- if section.settings.perk_2 != blank -%}
                    <li class="sweevit-product__option-perk">
                      {{- 'icon-checkmark.svg' | inline_asset_content -}}
                      <span>{{ section.settings.perk_2 | escape }}</span>
                    </li>
                  {%- endif -%}
                  {%- if section.settings.perk_3 != blank -%}
                    <li class="sweevit-product__option-perk">
                      {{- 'icon-checkmark.svg' | inline_asset_content -}}
                      <span>{{ section.settings.perk_3 | escape }}</span>
                    </li>
                  {%- endif -%}
                </ul>
              {%- endif -%}
            </label>
          {%- endif -%}
        </div>

        {%- if product != blank -%}
          <product-form class="product-form" data-section-id="{{ section.id }}">
            <div class="product-form__error-message-wrapper" role="alert" hidden>
              <span class="product-form__error-message"></span>
            </div>

            {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
              <input
                type="hidden"
                name="id"
                value="{{ current_variant.id }}"
                class="product-variant-id"
                {% if current_variant.available == false %}disabled{% endif %}
              >
              <input type="hidden" value="" data-selling-plan-input>

              <div class="sweevit-product__purchase">
                <div class="sweevit-product__quantity">
                  <button
                    type="button"
                    class="sweevit-product__qty-btn"
                    data-quantity-minus
                    aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}"
                  >
                    &minus;
                  </button>
                  <input
                    class="sweevit-product__qty-input"
                    type="number"
                    name="quantity"
                    value="1"
                    min="1"
                    {% if current_variant.quantity_rule.max != null %}
                      max="{{ current_variant.quantity_rule.max }}"
                    {% endif %}
                    step="1"
                    data-quantity-input
                    aria-label="{{ 'products.product.quantity.input_label' | t: product: product.title | escape }}"
                  >
                  <button
                    type="button"
                    class="sweevit-product__qty-btn"
                    data-quantity-plus
                    aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}"
                  >
                    +
                  </button>
                </div>

                <button
                  type="submit"
                  name="add"
                  class="sweevit-product__atc"
                  {% if current_variant.available == false %}disabled{% endif %}
                >
                  <span>{{ section.settings.button_label | escape }}</span>
                  {%- render 'loading-spinner' -%}
                </button>
              </div>
            {%- endform -%}
          </product-form>
        {%- else -%}
          <div class="sweevit-product__purchase">
            <div class="sweevit-product__quantity">
              <button type="button" class="sweevit-product__qty-btn" data-quantity-minus aria-label="Decrease quantity">&minus;</button>
              <input class="sweevit-product__qty-input" type="number" value="1" min="1" step="1" data-quantity-input aria-label="Quantity">
              <button type="button" class="sweevit-product__qty-btn" data-quantity-plus aria-label="Increase quantity">+</button>
            </div>
            <button type="button" class="sweevit-product__atc" disabled>
              <span>{{ section.settings.button_label | escape }}</span>
            </button>
          </div>
        {%- endif -%}

        {%- if section.settings.secure_checkout_text != blank -%}
          <p class="sweevit-product__secure">
            {{- 'icon-lock.svg' | inline_asset_content -}}
            <span>{{ section.settings.secure_checkout_text | escape }}</span>
          </p>
        {%- endif -%}
      </div>
    </div>
  </sweevit-product-showcase>
</section>

<script src="{{ 'sweevit-product-showcase.js' | asset_url }}" defer="defer"></script>
{%- if product != blank -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Sweevit product showcase",
  "tag": "section",
  "class": "section-sweevit-product-showcase",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_image",
      "label": "Use custom product image",
      "default": false,
      "info": "When off, the theme uses MiniPouch-product.png from assets."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom product image",
      "info": "Only used when “Use custom product image” is enabled."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sweevit Functional Gummies"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Focus, Energy & Wellness"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Rating value",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "default": "217"
    },
    {
      "type": "text",
      "id": "review_label",
      "label": "Review label",
      "default": "reviews"
    },
    {
      "type": "header",
      "content": "Purchase options"
    },
    {
      "type": "checkbox",
      "id": "show_subscribe",
      "label": "Show subscribe option",
      "default": true
    },
    {
      "type": "select",
      "id": "default_purchase_option",
      "label": "Default option",
      "options": [
        { "value": "subscribe", "label": "Subscribe & save" },
        { "value": "onetime", "label": "One-time purchase" }
      ],
      "default": "subscribe"
    },
    {
      "type": "text",
      "id": "one_time_label",
      "label": "One-time label",
      "default": "One-time purchase"
    },
    {
      "type": "text",
      "id": "subscribe_label",
      "label": "Subscribe label",
      "default": "Subscribe & Save 20%"
    },
    {
      "type": "text",
      "id": "one_time_price_fallback",
      "label": "One-time price (no product)",
      "default": "$39.00"
    },
    {
      "type": "text",
      "id": "subscribe_price_fallback",
      "label": "Subscribe price (no product)",
      "default": "$31.20"
    },
    {
      "type": "text",
      "id": "perk_1",
      "label": "Subscribe perk 1",
      "default": "Free shipping"
    },
    {
      "type": "text",
      "id": "perk_2",
      "label": "Subscribe perk 2",
      "default": "Cancel anytime"
    },
    {
      "type": "text",
      "id": "perk_3",
      "label": "Subscribe perk 3",
      "default": "Priority access"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "secure_checkout_text",
      "label": "Secure checkout text",
      "default": "Secure checkout"
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F7F7F5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Benefit highlight",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "focus", "label": "Focus" },
            { "value": "energy", "label": "Energy" },
            { "value": "wellness", "label": "Wellness" }
          ],
          "default": "focus"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Focus"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Subheading",
          "default": "Mental clarity & concentration"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sweevit product showcase",
      "blocks": [
        {
          "type": "highlight",
          "settings": {
            "icon": "focus",
            "title": "Focus",
            "description": "Mental clarity & concentration"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "icon": "energy",
            "title": "Energy",
            "description": "Natural energy without the crash"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "icon": "wellness",
            "title": "Wellness",
            "description": "Support your body & mind daily"
          }
        }
      ]
    }
  ]
}
{% endschema %}
