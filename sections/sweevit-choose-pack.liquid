{{ 'sweevit-design-system.css' | asset_url | stylesheet_tag }}
{{ 'section-sweevit-choose-pack.css' | asset_url | stylesheet_tag }}
{{ 'sweevit-carousel.css' | asset_url | stylesheet_tag }}
{{ 'sweevit-loading-spinner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sweevit-carousel.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign fallback_product = all_products['sweevit-functional-gummies']
  assign has_product_form = false
  for block in section.blocks
    assign check_product = block.settings.product | default: fallback_product
    if check_product != blank
      assign has_product_form = true
      break
    endif
  endfor
-%}

{%- style -%}
  #SweevitPack-{{ section.id }} {
    --sweevit-pack-bg: {{ section.settings.background_color }};
  }

  @media screen and (min-width: 990px) {
    #SweevitPack-{{ section.id }} .sweevit-pack__inner {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_horizontal }}px;
      padding-right: {{ section.settings.padding_horizontal }}px;
    }
  }
{%- endstyle -%}

<section
  id="SweevitPack-{{ section.id }}"
  class="sweevit-pack{% if section.settings.center_header %} sweevit-pack--centered{% endif %}"
>
  <div class="sweevit-pack__inner">
    <div class="sweevit-pack__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sweevit-pack__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="sweevit-pack__heading">
          <span class="sweevit-pack__heading-line">{{ section.settings.heading | escape }}</span>
        </h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="sweevit-pack__carousel" data-sweevit-carousel>
        <div class="sweevit-pack__track" data-carousel-track>
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_product = block.settings.product
            if card_product == blank
              assign card_product = all_products['sweevit-functional-gummies']
            endif
            assign card_variant = nil
            assign card_price = block.settings.price
            assign first_selling_plan = nil
            assign pack_form_id = 'sweevit-pack-form-' | append: block.id

            if card_product != blank
              assign card_variant = card_product.selected_or_first_available_variant
              assign card_price = card_variant.price | money
              for allocation in card_variant.selling_plan_allocations
                assign first_selling_plan = allocation.selling_plan
                if block.settings.card_style == 'subscribe'
                  assign card_price = allocation.price | money
                endif
                break
              endfor
            endif

            assign image_asset = 'sweetvit-1-pack.png'
            if block.settings.card_style == 'popular'
              assign image_asset = 'sweetvit-most-popular.png'
            elsif block.settings.card_style == 'subscribe'
              assign image_asset = 'sweetvit-subscribe.png'
            endif
          -%}

          <article
            class="sweevit-pack__card{% if block.settings.card_style == 'popular' %} sweevit-pack__card--popular{% endif %}"
            data-carousel-slide
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.card_style == 'popular' and block.settings.badge_text != blank -%}
              <span class="sweevit-pack__badge">{{ block.settings.badge_text | escape }}</span>
            {%- endif -%}

            {%- if block.settings.label != blank -%}
              <p class="sweevit-pack__label">{{ block.settings.label | escape }}</p>
            {%- endif -%}

            <div class="sweevit-pack__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 760
                  | image_tag:
                    class: 'sweevit-pack__image',
                    loading: 'lazy',
                    widths: '380, 760',
                    sizes: '(min-width: 990px) 380px, 100vw',
                    alt: block.settings.label
                }}
              {%- else -%}
                <img
                  src="{{ image_asset | asset_url }}"
                  class="sweevit-pack__image"
                  loading="lazy"
                  width="380"
                  height="212"
                  alt="{{ block.settings.label | escape }}"
                >
              {%- endif -%}
            </div>

            <div class="sweevit-pack__body">
              {%- if card_price != blank -%}
                <p class="sweevit-pack__price">{{ card_price }}</p>
              {%- endif -%}

              {%- if block.settings.price_note != blank -%}
                <p class="sweevit-pack__price-note">{{ block.settings.price_note | escape }}</p>
              {%- endif -%}

              {%- if block.settings.perk_1 != blank or block.settings.perk_2 != blank or block.settings.perk_3 != blank -%}
                <ul class="sweevit-pack__perks">
                  {%- if block.settings.perk_1 != blank -%}
                    <li class="sweevit-pack__perk">
                      {{- 'icon-checkmark.svg' | inline_asset_content -}}
                      <span>{{ block.settings.perk_1 | escape }}</span>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.perk_2 != blank -%}
                    <li class="sweevit-pack__perk">
                      {{- 'icon-checkmark.svg' | inline_asset_content -}}
                      <span>{{ block.settings.perk_2 | escape }}</span>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.perk_3 != blank -%}
                    <li class="sweevit-pack__perk">
                      {{- 'icon-checkmark.svg' | inline_asset_content -}}
                      <span>{{ block.settings.perk_3 | escape }}</span>
                    </li>
                  {%- endif -%}
                </ul>
              {%- endif -%}

              <div class="sweevit-pack__form">
                {%- if card_product != blank and card_variant != blank -%}
                  <product-form class="product-form" data-section-id="{{ section.id }}">
                    <div class="product-form__error-message-wrapper" role="alert" hidden>
                      <span class="product-form__error-message"></span>
                    </div>

                    {%- form 'product', card_product, id: pack_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                      <input
                        type="hidden"
                        name="id"
                        value="{{ card_variant.id }}"
                        class="product-variant-id"
                        {% if card_variant.available == false %}disabled{% endif %}
                      >
                      {%- if block.settings.card_style == 'subscribe' and first_selling_plan != nil -%}
                        <input type="hidden" name="selling_plan" value="{{ first_selling_plan.id }}">
                      {%- endif -%}

                      <button
                        type="submit"
                        name="add"
                        class="sweevit-pack__atc"
                        {% if card_variant.available == false %}disabled{% endif %}
                      >
                        <span>{{ block.settings.button_label | escape }}</span>
                        {%- render 'sweevit-loading-spinner' -%}
                      </button>
                    {%- endform -%}
                  </product-form>
                {%- else -%}
                  <button type="button" class="sweevit-pack__atc" disabled>
                    <span>{{ block.settings.button_label | escape }}</span>
                  </button>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
        </div>

        {%- if section.blocks.size > 1 -%}
          <div class="sweevit-carousel__dots" data-carousel-dots role="tablist" aria-label="Pack options">
            {%- for block in section.blocks -%}
              <button
                type="button"
                class="sweevit-carousel__dot{% if forloop.first %} is-active{% endif %}"
                data-carousel-dot
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="Pack {{ forloop.index }}"
              ></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- if has_product_form -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Sweevit Choose Pack",
  "tag": "section",
  "class": "section-sweevit-choose-pack",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Choose Your Pack"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start Your Daily Ritual."
    },
    {
      "type": "checkbox",
      "id": "center_header",
      "label": "Center header",
      "default": false
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F5F5F5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding horizontal",
      "default": 78
    }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Pack card",
      "settings": [
        {
          "type": "select",
          "id": "card_style",
          "label": "Card style",
          "options": [
            { "value": "default", "label": "Default" },
            { "value": "popular", "label": "Most popular (gradient)" },
            { "value": "subscribe", "label": "Subscribe" }
          ],
          "default": "default"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text",
          "default": "Most Popular",
          "info": "Shown on popular style only"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Pack label",
          "default": "1 Pack"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override",
          "info": "Uses default pack image when empty"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price (no product)",
          "default": "$39"
        },
        {
          "type": "text",
          "id": "price_note",
          "label": "Price note",
          "default": "One-time purchase"
        },
        {
          "type": "text",
          "id": "perk_1",
          "label": "Perk 1",
          "default": "Free shipping on 3+ packs"
        },
        {
          "type": "text",
          "id": "perk_2",
          "label": "Perk 2",
          "default": "Secure checkout"
        },
        {
          "type": "text",
          "id": "perk_3",
          "label": "Perk 3"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Add to cart"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sweevit Choose Pack",
      "blocks": [
        {
          "type": "pack",
          "settings": {
            "card_style": "default",
            "label": "1 Pack",
            "price": "$39",
            "price_note": "One-time purchase",
            "perk_1": "Free shipping on 3+ packs",
            "perk_2": "Secure checkout"
          }
        },
        {
          "type": "pack",
          "settings": {
            "card_style": "popular",
            "badge_text": "Most Popular",
            "label": "3 Packs",
            "price": "$99",
            "price_note": "Save 15%",
            "perk_1": "Free shipping",
            "perk_2": "Cancel anytime",
            "perk_3": "Priority access"
          }
        },
        {
          "type": "pack",
          "settings": {
            "card_style": "subscribe",
            "label": "Subscribe",
            "price": "$31",
            "price_note": "per pack · Save 20%",
            "perk_1": "Free shipping on 3+ packs",
            "perk_2": "Secure checkout"
          }
        }
      ]
    }
  ]
}
{% endschema %}
